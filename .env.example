# Copy this file to .env and fill in your own API key and model.
OPENAI_API_KEY=your-api-key
EEG_LLM_MODEL=your-model-name

# Optional: an OpenAI-compatible endpoint; omit to use the default OpenAI endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: request timeout in seconds (1-300; default 60).
EEG_LLM_TIMEOUT_SECONDS=60
